# Copy this file to .env and adjust if needed. Defaults match what the stack
# was originally set up with, all scoped to localhost — nothing here needs to
# be secret, it's a local dev environment.

# CN used when generating the self-signed TLS certs (scripts/generate-certs.sh).
CERT_SUBJECT_CN=localhost

# users-db (RESQL) row seeded by scripts/seed-db.sh — identifies this
# institution instance to the bot/backoffice.
BOT_INSTITUTION_ID=test

# Keycloak (local stand-in for TARA) admin console login.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
